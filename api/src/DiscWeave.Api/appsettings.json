{
  "ConnectionStrings": {
    "DiscWeave": ""
  },
  "ReleaseCovers": {
    "StorageRoot": "var/release-covers"
  },
  "Discogs": {
    "BaseUrl": "https://api.discogs.com",
    "UserAgent": "DiscWeave/0.1 (+https://github.com/Fredoq/discweave)",
    "TimeoutSeconds": 10,
    "MaxOriginalRouteLookups": 5,
    "MaxOriginalSearchResultsPerRoute": 3,
    "MaxOriginalRequestsPerRoute": 12,
    "MaxOriginalRequestsPerDiscovery": 25,
    "OriginalDiscoveryTimeoutSeconds": 30
  },
  "MusicBrainz": {
    "Enabled": true,
    "BaseUrl": "https://musicbrainz.org",
    "ApplicationName": "DiscWeave",
    "ApplicationVersion": "1.0.0",
    "Contact": "https://github.com/Fredoq/discweave",
    "TimeoutSeconds": 15,
    "OperationTimeoutSeconds": 60,
    "MinimumRequestIntervalMilliseconds": 1000,
    "MaxRetries": 2,
    "MaxRetryAfterSeconds": 10,
    "MaxRequestsPerOperation": 40,
    "MaxRecordingCandidates": 5,
    "MaxLineageCandidates": 5,
    "MaxReleasePagesPerRecording": 5,
    "MaxReleaseGroupLookups": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DiscWeave": {
    "StorageProvider": "Sqlite"
  }
}
